# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Auth (required in production) ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Database ----
# Leave DATABASE_URL empty to use a local SQLite file (data/isip.sqlite).
# For PostgreSQL (e.g. Neon / Railway) set it like:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
DB_SSL=true

# ---- Data encryption (AES-256-GCM for sensitive fields such as phone numbers) ----
ENCRYPTION_KEY=change-this-too

# ---- File storage ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ---- First start in production ----
# Your administrator account (password: 8+ characters with a letter and a number). Created if it doesn't exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Load the demo startups, mentors and investors into an empty production database.
# Demo data is only loaded in production when DEMO_PASSWORD is set; every demo account then uses it.
SEED_DEMO=false
DEMO_PASSWORD=

# ---- Email (optional) ----
# If SMTP_HOST is empty, emails are printed to the server console instead.
# In production without SMTP, new accounts are verified automatically at sign-up.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="StartIn ISIP <no-reply@isip.local>"
