# Leave empty in development (Vite proxies /api to localhost:5000).
# In production (e.g. Vercel) set to your backend URL, e.g. https://isip-api.onrender.com/api
VITE_API_URL=

# Branding shown in the portal header and footer (optional).
VITE_INSTITUTE_NAME=Institute Innovation Council
VITE_HELPDESK_EMAIL=incubation@isip.edu

# TEMPORARY (lab demo only): adds a tiny key button on the login page that fills in these accounts.
# Set it in Vercel, never commit real values. Format: email:password,email:password
# Delete it and redeploy to remove the button.
VITE_DEMO_LOGINS=
